    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
