# Clauseora — Environment Variables
# Copy this to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.

# Required: Groq API key (primary analyzer)
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required: Cloudflare Workers AI (evidence verifier)
# Get your Account ID at https://dash.cloudflare.com → Workers & Pages → Overview
# Get an AI token at https://dash.cloudflare.com → My Profile → API Tokens
# Token needs "Workers AI" permission with Edit access
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_AI_TOKEN=your_cloudflare_ai_token_here

# Optional: OpenRouter fallback (disabled by default)
# Only enable if you have tested it with an exact pinned model and ZDR routing.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
